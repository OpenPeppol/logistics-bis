<?xml version="1.0" encoding="UTF-8"?>
<testSet xmlns="http://difi.no/xsd/vefa/validator/1.0" configuration="peppolbis-T125-base-1.0">
	<assert>
		<description>Verify that a shipment stage with transport mode code 4, air transport, uses an air service type code as transport means type code.</description>
		<scope>PEPPOL-T125-R052</scope>
	</assert>

	<test id="1">
		<!-- Main carriage by air on a passenger flight that carries cargo in the hold -->
		<assert>
			<success>PEPPOL-T125-R052</success>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:Consignment>
					<cbc:ID>1</cbc:ID>
					<cac:MainCarriageShipmentStage>
						<cbc:TransportModeCode>4</cbc:TransportModeCode>
						<cbc:TransportMeansTypeCode>J</cbc:TransportMeansTypeCode>
					</cac:MainCarriageShipmentStage>
				</cac:Consignment>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

	<test id="2">
		<!-- Main carriage by air on a freighter -->
		<assert>
			<success>PEPPOL-T125-R052</success>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:Consignment>
					<cbc:ID>1</cbc:ID>
					<cac:MainCarriageShipmentStage>
						<cbc:TransportModeCode>4</cbc:TransportModeCode>
						<cbc:TransportMeansTypeCode>F</cbc:TransportMeansTypeCode>
					</cac:MainCarriageShipmentStage>
				</cac:Consignment>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

	<test id="3">
		<!-- Road transport, the rule does not apply -->
		<assert>
			<success>PEPPOL-T125-R052</success>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:ShipmentStage>
					<cbc:TransportModeCode>3</cbc:TransportModeCode>
					<cbc:TransportMeansTypeCode>31</cbc:TransportMeansTypeCode>
				</cac:ShipmentStage>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

	<test id="4">
		<!-- Air transport without a transport means type code, the rule does not apply -->
		<assert>
			<success>PEPPOL-T125-R052</success>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:Consignment>
					<cbc:ID>1</cbc:ID>
					<cac:MainCarriageShipmentStage>
						<cbc:TransportModeCode>4</cbc:TransportModeCode>
					</cac:MainCarriageShipmentStage>
				</cac:Consignment>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

	<test id="5">
		<!-- Air transport on the shipment stage, air service type code -->
		<assert>
			<success>PEPPOL-T125-R052</success>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:ShipmentStage>
					<cbc:TransportModeCode>4</cbc:TransportModeCode>
					<cbc:TransportMeansTypeCode>F</cbc:TransportMeansTypeCode>
				</cac:ShipmentStage>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

	<test id="6">
		<!-- Air transport with a road code from UN/ECE Recommendation 28 -->
		<assert>
			<error>PEPPOL-T125-R052</error>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:Consignment>
					<cbc:ID>1</cbc:ID>
					<cac:MainCarriageShipmentStage>
						<cbc:TransportModeCode>4</cbc:TransportModeCode>
						<cbc:TransportMeansTypeCode>31</cbc:TransportMeansTypeCode>
					</cac:MainCarriageShipmentStage>
				</cac:Consignment>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

	<test id="7">
		<!-- Air transport with free text instead of a code -->
		<assert>
			<error>PEPPOL-T125-R052</error>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:Consignment>
					<cbc:ID>1</cbc:ID>
					<cac:MainCarriageShipmentStage>
						<cbc:TransportModeCode>4</cbc:TransportModeCode>
						<cbc:TransportMeansTypeCode>Airliner</cbc:TransportMeansTypeCode>
					</cac:MainCarriageShipmentStage>
				</cac:Consignment>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

	<test id="8">
		<!-- Air transport on the shipment stage with a road code -->
		<assert>
			<error>PEPPOL-T125-R052</error>
		</assert>
		<ubl:Waybill xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Waybill-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cac:Shipment>
				<cbc:ID>1</cbc:ID>
				<cac:ShipmentStage>
					<cbc:TransportModeCode>4</cbc:TransportModeCode>
					<cbc:TransportMeansTypeCode>3304</cbc:TransportMeansTypeCode>
				</cac:ShipmentStage>
			</cac:Shipment>
		</ubl:Waybill>
	</test>

</testSet>
