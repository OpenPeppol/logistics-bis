<?xml version="1.0" encoding="UTF-8"?>
<testSet xmlns="http://difi.no/xsd/vefa/validator/1.0" configuration="peppolbis-T131-base-1.0">
	<assert>
		<description>Verify that the cbc:CustomizationID is correct</description>
		<scope>PEPPOL-T131-R001</scope>
	</assert>

	<test id="1">
		<assert>
			<success>PEPPOL-T131-R001</success>
		</assert>
		<ubl:Manifest xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Manifest-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cbc:CustomizationID>urn:fdc:peppol.eu:logistics:trns:manifest:1</cbc:CustomizationID>
			<cbc:ProfileID>urn:fdc:peppol.eu:logistics:bis:manifest_w_application_response:1</cbc:ProfileID>
		</ubl:Manifest>
	</test>

	<test id="2">
		<assert>
			<error>PEPPOL-T131-R001</error>
		</assert>
		<ubl:Manifest xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Manifest-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cbc:CustomizationID>urn:fdc:peppol.eu:logistics:trns:waybill:1</cbc:CustomizationID>
			<cbc:ProfileID>urn:fdc:peppol.eu:logistics:bis:manifest_w_application_response:1</cbc:ProfileID>
		</ubl:Manifest>
	</test>

</testSet>
