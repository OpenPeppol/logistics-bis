<?xml version="1.0" encoding="UTF-8"?>
<testSet xmlns="http://difi.no/xsd/vefa/validator/1.0" configuration="peppolbis-T131-base-1.0">
	<assert>
		<description>Verify that IssueTime is specified with time zone</description>
		<scope>PEPPOL-T131-R003</scope>
	</assert>

	<test id="1">
		<assert>
			<success>PEPPOL-T131-R003</success>
		</assert>
		<ubl:Manifest xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Manifest-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cbc:IssueDate>2026-09-23</cbc:IssueDate>
			<cbc:IssueTime>09:30:00+02:00</cbc:IssueTime>
		</ubl:Manifest>
	</test>

	<test id="2">
		<assert>
			<success>PEPPOL-T131-R003</success>
		</assert>
		<ubl:Manifest xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Manifest-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cbc:IssueDate>2026-09-23</cbc:IssueDate>
			<cbc:IssueTime>07:30:00Z</cbc:IssueTime>
		</ubl:Manifest>
	</test>

	<test id="3">
		<assert>
			<error>PEPPOL-T131-R003</error>
		</assert>
		<ubl:Manifest xmlns:ubl="urn:oasis:names:specification:ubl:schema:xsd:Manifest-2"
			xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
			xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2">
			<cbc:IssueDate>2026-09-23</cbc:IssueDate>
			<cbc:IssueTime>09:30:00</cbc:IssueTime>
		</ubl:Manifest>
	</test>

</testSet>
